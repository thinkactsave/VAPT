# Required when NODE_ENV=production. Generate with:
# openssl rand -base64 48
PROOFVAPT_API_TOKEN=

# Set to a writable persistent mount in production.
PROOFVAPT_DATA_DIR=/data

# Web server
NODE_ENV=production
PORT=3000

# Optional: set to 1 only when the app is behind a trusted reverse proxy.
TRUST_PROXY=0
